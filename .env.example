# 后端容器环境变量配置（供 docker-compose 使用）
#
# 使用说明：
# 1. 复制本文件为 .env（注意文件名没有 .example）
# 2. 根据实际环境修改下面的值
# 3. 执行 `docker compose up -d` 时，docker-compose.yml 中的 ${...} 会从同级目录下的 .env 中读取
#
# 注意：
# - 请不要把带有真实密码的 .env 文件提交到 Git 仓库
# - 一般做法是：.gitignore 忽略 .env，只提交本 .env.example 模板

# =========================
# 镜像标签（可选）
# =========================
# 打包出的镜像标签，不设则默认为 latest。例如：v1.0
IMAGE_TAG=latest

# =========================
# MySQL 数据库配置
# =========================

# JDBC 连接串（示例为本地 MySQL）
DB_URL=jdbc:mysql://localhost:3306/dragons?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8

# 数据库用户名
DB_USER=root

# 数据库密码
DB_PASS=123456


# =========================
# Redis 配置
# =========================

# Redis 主机名（本地开发通常为 localhost，容器内可写成 redis 容器名）
REDIS_HOST=localhost

# Redis 端口
REDIS_PORT=6379

# 如使用 Redis ACL 用户名则填写；否则留空或删除此行
REDIS_USER=

# 如 Redis 有密码请填写；否则留空或删除此行
REDIS_PASS=


# =========================
# 前端 API 地址（构建时注入）
# =========================

# 后端 API 基础 URL，供前端镜像构建时使用
# - 留空：使用相对路径，请求走当前域名，由 nginx 转发到后端（推荐，ECS + nginx）
# - 直连后端：如 http://localhost:8080 或 http://<ECS_IP>:8080
VITE_API_BASE_URL=

