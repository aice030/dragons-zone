# Dragons Zone 部署环境变量示例
# 复制为 .env 并填写实际值，勿将 .env 提交到仓库

# ---------- 数据库（二选一）----------
# 使用阿里云 RDS 时填写，并直接运行: docker compose up -d
SPRING_DATASOURCE_URL=jdbc:mysql://你的RDS地址:3306/dragons?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
SPRING_DATASOURCE_USERNAME=你的数据库用户名
SPRING_DATASOURCE_PASSWORD=你的数据库密码

# 使用同机 MySQL 容器时，使用下面三行并运行: docker compose --profile with-db up -d
# SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/dragons?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
# SPRING_DATASOURCE_USERNAME=dragons
# SPRING_DATASOURCE_PASSWORD=dragons

# ---------- MySQL 容器（仅 --profile with-db 时使用）----------
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=dragons
MYSQL_USER=dragons
MYSQL_PASSWORD=dragons

# ---------- JWT ----------
JWT_SECRET=请使用足够长且随机的生产环境密钥
JWT_EXPIRATION=604800000

# ---------- 阿里云 OSS ----------
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=你的AccessKeyId
OSS_ACCESS_KEY_SECRET=你的AccessKeySecret
OSS_BUCKET=dragons-media
